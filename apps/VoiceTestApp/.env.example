# Copy to .env — Expo inlines EXPO_PUBLIC_* variables into the JS bundle at build/start time.
# Everything is optional: with no .env the app runs tiers 1 and 2 only, and the backend URL can be typed in the UI.

# Tier-3 backend (the reference proxy or your own server implementing proxy/CONTRACT.md)
EXPO_PUBLIC_VOICE_BACKEND_URL=http://192.168.1.10:8080
# Bearer token if the backend was started with PROXY_TOKEN (leave empty otherwise)
EXPO_PUBLIC_VOICE_BACKEND_TOKEN=

# Optional: remote pack catalog (defaults to the catalog bundled in the app; the proxy also serves /v1/catalog.json)
EXPO_PUBLIC_VOICE_CATALOG_URL=

# Optional: default language code (hi, en, ta, ...) or auto
EXPO_PUBLIC_VOICE_DEFAULT_LANGUAGE=hi
