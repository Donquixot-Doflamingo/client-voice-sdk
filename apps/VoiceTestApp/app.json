{
  "expo": {
    "name": "Indic Voice Test",
    "slug": "indic-voice-test",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "indicvoice",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "dev.indicvoice.testapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "ios": {
      "bundleIdentifier": "dev.indicvoice.testapp",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The microphone is used to test speech-to-text.",
        "NSSpeechRecognitionUsageDescription": "Apple speech recognition is used as tier 1 of the voice SDK.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}