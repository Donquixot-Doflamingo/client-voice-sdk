# Build output (CI builds the jars: .github/workflows/android-apk.yml; locally: scripts/build-jvm.sh)
build/
dist/
*.class
.gradle/
**/build/

# Downloaded at build/run time (scripts/fetch-sherpa.sh, apps/VoiceTestApp/scripts/fetch-sherpa.js, bin/indicvoice packs install)
third_party/sherpa-onnx/libs/*.jar
third_party/sherpa-onnx/libs/*.aar
apps/VoiceTestApp/modules/indic-voice/ios/Frameworks/*.xcframework/
apps/VoiceTestApp/modules/indic-voice/ios/Frameworks/*.zip
packs/
*.onnx
*.tar.bz2

# Laptop test kit extras (bundled Java runtime, models, keys) — never commit these
jre/
_to_delete/
sarvam-key.txt
*.key
.env
.env.local

# Recordings and logs from testing (may contain people's voices)
*.wav
*.log
debug-audio/
eval/

# React Native / Expo
node_modules/
apps/VoiceTestApp/android/
apps/VoiceTestApp/ios/
apps/VoiceTestApp/.expo/

# OS / editors
.DS_Store
.idea/
.vscode/
*.iml
